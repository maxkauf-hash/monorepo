{
  "name": "@apps/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @packages/database db:generate",
    "db:migrate": "pnpm --filter @packages/database db:migrate",
    "db:push": "pnpm --filter @packages/database db:push",
    "db:studio": "pnpm --filter @packages/database db:studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "env-schema": "^8.0.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
